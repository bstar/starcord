# Maintainer: bstar <bob@dinicolas.com>
pkgname=starcord
pkgver=0.0.2
pkgrel=1
pkgdesc="A Winamp-feel terminal Discord client"
arch=('x86_64' 'aarch64')
url="https://github.com/bstar/starcord"
license=('MIT')
# The C runtime, and nothing else. There is no ffmpeg, no ALSA and no libdbus
# here: TLS is rustls, and the keyring and the notification daemon are both
# reached over zbus, which speaks the D-Bus protocol without linking libdbus.
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=(
  'noto-fonts-emoji: colour emoji in messages'
  'gnome-keyring: somewhere to keep the token other than a mode-0600 file'
  'kwallet: the same, on Plasma'
  'mpv: playing a video attachment'
)
# makepkg enables LTO by default, which makes the C and assembly that `ring`
# and `blake3` compile land in their static archives as LTO bitcode. rustc
# links with lld, which does not read it, and the symbols come back undefined.
# The Rust toolchain does its own LTO through the release profile regardless.
options=(!lto)
# The release tarball, not GitHub's generated /archive/ one: that is produced
# on the fly and its bytes have changed under the AUR before, invalidating
# every checksum at once. This one is built by `git archive` at the tag and
# uploaded, so it can carry a real checksum.
#
# SKIP here, and only here: the hash of a tarball made from this tree cannot be
# written into this tree without changing it. The AUR copy of this file is
# published after the release exists and carries the real value, which is the
# copy anybody actually installs from.
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # This needs network, which prepare() has and build() should not rely on.
  # One of the dependencies is not on crates.io: `starkit` is this project's
  # own shared foundation, pinned to a git tag in Cargo.lock, and `cargo fetch`
  # is what puts it in CARGO_HOME so that the --frozen build below can be
  # offline like every other Arch build.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Nothing here needs an account or a network: the tests that would are gated
  # behind STARCORD_TEST_TOKEN and skip cleanly without it.
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 packaging/starcord.desktop \
    "$pkgdir/usr/share/applications/starcord.desktop"
  install -Dm0644 packaging/starcord.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/starcord.png"
  install -Dm0644 packaging/starcord.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/starcord.svg"
}
